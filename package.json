{
  "name": "creator-care-relay",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-minimized, human-approved community care plans through a persistent Minds agent.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js",
    "demo": "tsc -p tsconfig.json && node dist/src/cli.js --fixture fixtures/community-incident.json"
  },
  "dependencies": {
    "@animocabrands/minds-client-lib": "0.1.3"
  },
  "devDependencies": {
    "@types/node": "22.17.0",
    "typescript": "5.9.2"
  }
}
